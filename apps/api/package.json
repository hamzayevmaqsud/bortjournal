{
  "name": "@bortjournal/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Бэкенд Бортжурнала: модульный монолит на Fastify + Drizzle + Postgres",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bortjournal/core": "*",
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.5",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "mammoth": "1.13.0",
    "nodemailer": "6.10.1",
    "pg": "8.23.1",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "@types/nodemailer": "6.4.24",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
