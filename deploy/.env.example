# Скопируй в deploy/.env и заполни. Файл .env в git не попадает.

# домен, на который смотрит A-запись DNS (без https://)
DOMAIN=lumi.example.com
# адрес сайта целиком — для ссылок в письмах, календаре и OAuth
PUBLIC_URL=https://lumi.example.com
# какие имена хоста API принимает (защита от подмены Host)
ALLOWED_HOSTS=lumi.example.com

# пароль базы: длинный и случайный, например: openssl rand -base64 30
POSTGRES_PASSWORD=

# ИИ (фото еды, вопросы по конспектам): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# вход через Google и Google Календарь: Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
#   адреса возврата: https://<домен>/api/auth/google/callback и https://<домен>/api/integrations/google-calendar/callback
#   и включить Google Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ключ шифрования токенов интеграций (32 байта base64): openssl rand -base64 32
# если пусто — создастся файл data/integrations.key; тогда бэкапь его вместе с базой (backup.sh это делает)
INTEGRATIONS_KEY=

# от кого уведомления (Web Push): почта владельца
PUSH_SUBJECT=mailto:me@example.com

# сколько дней хранить бэкапы на сервере
BACKUP_KEEP_DAYS=14

# закрытая бета: у всех весь Pro бесплатно, экранов оплаты нет
BETA_PRO=1
# логины админов через запятую (админка, ссылки для сброса пароля)
ADMIN_USERS=

# почта через Gmail: адрес и пароль приложения (Аккаунт Google → Безопасность → Пароли приложений)
SMTP_USER=
SMTP_PASS=
# от кого письма (по умолчанию «Lumi <SMTP_USER>»); для Resend — обязательно
MAIL_FROM=
# куда присылать отзывы
ADMIN_EMAIL=
# или вместо Gmail — Resend
RESEND_API_KEY=

# отзывы в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# туннель Cloudflare (docker-compose.shared.yml, профиль tunnel)
TUNNEL_TOKEN=
