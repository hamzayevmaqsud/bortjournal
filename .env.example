# Скопируй в .env и впиши свой ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Модели по порядку: если у первой кончился лимит, берётся следующая
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite
# Сколько фото в день на одного пользователя
# PHOTO_DAILY_LIMIT=60
# Obsidian: папка хранилища, логин в журнале, куда смотреть и куда класть шпаргалки
# OBSIDIAN_VAULT=/Users/me/Library/Mobile Documents/iCloud~md~obsidian/Documents/MyVault
# OBSIDIAN_USER=me
# OBSIDIAN_FOLDER=Учёба
# OBSIDIAN_CHEATS=Шпаргалки
